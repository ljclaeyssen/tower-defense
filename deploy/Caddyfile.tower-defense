# Installed on the VPS as /etc/caddy/sites/tower-defense (Caddy imports /etc/caddy/sites/*).
# Static Angular front for now; phase 3 adds the Colyseus server behind /ws
# (handle /ws* { reverse_proxy 127.0.0.1:2567 }).
tower-defense.ljclaeyssen.fr {
    root * /opt/apps/tower-defense/frontend
    encode zstd gzip

    # Hashed bundles never change: cache them for a year.
    @hashed path_regexp [-.][A-Za-z0-9_]{8,}\.(js|css)$
    header @hashed Cache-Control "public, max-age=31536000, immutable"

    # Entry point, translations and the art atlas (fixed file names) must always be revalidated.
    @noCache {
        path / /index.html /i18n/* /assets/*
    }
    header @noCache Cache-Control "no-cache"

    try_files {path} /index.html
    file_server
}
