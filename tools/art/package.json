{
  "name": "@td/art",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "@td/source": "./src/index.ts",
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "nx": {
    "name": "art",
    "projectType": "application",
    "tags": [
      "scope:tools"
    ],
    "targets": {
      "build": {
        "executor": "nx:run-commands",
        "cache": true,
        "inputs": [
          "{projectRoot}/src/**/*",
          "{workspaceRoot}/libs/shared/src/data/**/*"
        ],
        "outputs": [
          "{workspaceRoot}/apps/web/public/assets"
        ],
        "options": {
          "command": "tsx src/build.ts",
          "cwd": "tools/art"
        }
      },
      "watch": {
        "executor": "nx:run-commands",
        "continuous": true,
        "options": {
          "command": "tsx src/build.ts --watch",
          "cwd": "tools/art"
        }
      }
    }
  },
  "dependencies": {
    "@td/shared": "*"
  }
}
